# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# You can use a local MongoDB instance or a free MongoDB Atlas connection string:
# Local: mongodb://localhost:27017/mit_exchange_hub
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mit_exchange_hub?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mit_exchange_hub

# JWT Authentication
JWT_SECRET=mit_exchange_hub_jwt_super_secret_key_2026_cse_pbl
JWT_EXPIRES_IN=7d

# Institute Verification Rules
# Comma-separated allowed email domains
INSTITUTE_DOMAINS=demo.edu,mit.edu,mitadt.edu.in

# Email Verification Mode
# In development, set to true to auto-verify newly registered accounts or log verification link to console.
# Set to false if using a real SMTP service.
AUTO_VERIFY_EMAIL=true

# Optional SMTP Email Service (e.g. Mailtrap / Gmail / Sendgrid)
# If empty, verification emails & reset tokens are safely logged to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MIT Exchange Hub <noreply@demo.edu>

# Auction System
AUCTION_CHECK_INTERVAL_MS=15000
